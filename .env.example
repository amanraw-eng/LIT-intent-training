# Copy to .env at the repository root. Do not commit the resulting .env file.
# Put only secrets and machine/deployment-specific overrides here.

# API credentials
OPENAI_API_KEY=
HF_TOKEN=
WANDB_API_KEY=
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_TOKEN=
MONGO_DB_URI=
# Gemini Vertex AI service-account JSON (keep this file under .secrets/)
GEMINI_KEY_PATH=.secrets/gemini-service-account.json

# Optional deployment overrides (defaults are in shared_settings.py)
HF_HOME=
HF_DATASETS_CACHE=
NGROK_ENDPOINT=
TTS_WS_ENDPOINT=
TTS_VOICE_ID=
